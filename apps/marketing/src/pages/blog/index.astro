---
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatBlogDate, getBlogArticles } from "../../lib/blog";
import { productLinks } from "../../lib/product-links";

const articles = await getBlogArticles();
---

<BaseLayout
  title="Brand building articles | Sandcastle"
  description="Practical articles about creating and maintaining a coherent Brand System."
>
  <Header productUrl={productLinks.brandBrief} signInUrl={productLinks.signIn} />
  <main class="mx-auto min-h-[70vh] max-w-5xl px-5 py-16 sm:px-8 sm:py-24">
    <p class="eyebrow">Sandcastle journal</p>
    <h1 class="marketing-heading mt-4 text-5xl tracking-[-0.035em] sm:text-6xl">Build a coherent brand</h1>
    <p class="mt-6 max-w-2xl text-lg leading-8 text-[var(--sc-color-muted)]">
      Clear guidance for founders who want a Brand System that is ready to ship.
    </p>
    <ol class="mt-14 grid gap-6">
      {articles.map(({ data, id }) => (
        <li>
          <article class="rounded-[var(--sc-corner-panel)] border border-[var(--sc-color-sand)] bg-[var(--sc-color-surface)] p-6 sm:p-8">
            <p class="technical-label">{data.category}</p>
            <h2 class="marketing-heading mt-3 text-3xl sm:text-4xl">
              <a class="rounded-[var(--sc-corner-control)]" href={`/blog/${id}/`}>{data.title}</a>
            </h2>
            <p class="mt-4 max-w-2xl leading-7 text-[var(--sc-color-muted)]">{data.description}</p>
            <p class="mt-5 text-sm text-[var(--sc-color-muted)]">
              <time datetime={data.publicationDate.toISOString()}>
                {formatBlogDate(data.publicationDate)}
              </time>
              {` · ${data.author}`}
            </p>
          </article>
        </li>
      ))}
    </ol>
  </main>
  <Footer productUrl={productLinks.brandBrief} />
</BaseLayout>

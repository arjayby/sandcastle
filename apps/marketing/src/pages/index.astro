---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { productLinks } from "../lib/product-links";
---

<BaseLayout
  title="Sandcastle"
  description="Create a complete, coherent Brand System with an expert AI Brand Agent."
>
  <Header productUrl={productLinks.home} signInUrl={productLinks.signIn} />
  <Hero productUrl={productLinks.home} />
  <Footer productUrl={productLinks.home} />
</BaseLayout>

---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const productOrigin = (import.meta.env.PUBLIC_PRODUCT_URL ?? "http://localhost:5173").replace(
  /\/$/,
  "",
);
const productUrl = `${productOrigin}/`;
const signInUrl = `${productOrigin}/dashboard`;
---

<BaseLayout
  title="Sandcastle"
  description="Create a complete, coherent Brand System with an expert AI Brand Agent."
>
  <Header productUrl={productUrl} signInUrl={signInUrl} />
  <Hero productUrl={productUrl} />
  <Footer productUrl={productUrl} />
</BaseLayout>

---
import BrandSystemExample from "../components/BrandSystemExample.astro";
import Collaboration from "../components/Collaboration.astro";
import DeliveryProof from "../components/DeliveryProof.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Workflow from "../components/Workflow.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { productLinks } from "../lib/product-links";
---

<BaseLayout
  title="Sandcastle"
  description="Create a complete, coherent Brand System with an expert AI Brand Agent."
>
  <Header productUrl={productLinks.brandBrief} signInUrl={productLinks.signIn} />
  <main>
    <Hero productUrl={productLinks.brandBrief} />
    <BrandSystemExample />
    <Workflow />
    <DeliveryProof productUrl={productLinks.brandBrief} />
    <Collaboration productUrl={productLinks.brandBrief} />
  </main>
  <Footer productUrl={productLinks.brandBrief} />
</BaseLayout>

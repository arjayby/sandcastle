---
interface Props {
  productUrl: string;
}

const { productUrl } = Astro.props;
---

<section
  class="mx-auto grid max-w-7xl gap-12 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[minmax(0,0.88fr)_minmax(30rem,1.12fr)] lg:items-center lg:gap-16 lg:py-32"
>
    <div class="max-w-2xl">
      <p class="eyebrow">A complete brand, built together</p>
      <h1
        class="marketing-heading mt-5 max-w-3xl text-5xl leading-[0.98] tracking-[-0.035em] sm:text-6xl lg:text-7xl"
      >
        Go from a Brand Brief to a brand that is ready to ship.
      </h1>
      <p class="mt-7 max-w-xl text-lg leading-8 text-[var(--sc-color-muted)]">
        Direct an expert Brand Agent in plain language. Shape one coherent Brand System
        across every customer touchpoint.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a class="action-link" href={productUrl}>Build your Brand System</a>
        <a class="secondary-link" href="#example">View an example</a>
      </div>
      <p class="mt-5 text-sm text-[var(--sc-color-muted)]">
        Start with your Brand Brief. Sign in only when you are ready to generate.
      </p>
    </div>

    <div class="canvas-demo" aria-label="Brand Canvas demonstration">
      <div class="canvas-toolbar">
        <div class="flex items-center gap-2" aria-hidden="true">
          <span class="canvas-dot"></span>
          <span class="canvas-dot"></span>
          <span class="canvas-dot"></span>
        </div>
        <p class="technical-label">Northstar Brand Canvas</p>
        <p class="technical-label text-[#667085]">100%</p>
      </div>
      <div class="canvas-grid">
        <div class="canvas-region canvas-region-logo">
          <p class="technical-label text-[#aebbd0]">Logo</p>
          <div class="mt-auto">
            <p class="northstar-wordmark">Northstar</p>
            <p class="mt-2 text-xs text-[#aebbd0]">Find the signal. Move with clarity.</p>
          </div>
        </div>
        <div class="canvas-region canvas-region-color">
          <p class="technical-label">Color</p>
          <div class="mt-auto flex gap-2" aria-label="Northstar color palette">
            <span class="color-swatch bg-[#24334b]"></span>
            <span class="color-swatch bg-[#ee7c58]"></span>
            <span class="color-swatch bg-[#f7f1df]"></span>
          </div>
        </div>
        <div class="canvas-region canvas-region-type">
          <p class="technical-label">Typography</p>
          <p class="northstar-serif mt-auto text-4xl leading-none">Aa</p>
        </div>
        <div class="canvas-region canvas-region-photo overflow-hidden">
          <p class="technical-label relative z-10 text-[#f7f1df]">Photography</p>
          <div class="photo-sun" aria-hidden="true"></div>
          <div class="photo-ridge photo-ridge-back" aria-hidden="true"></div>
          <div class="photo-ridge photo-ridge-front" aria-hidden="true"></div>
        </div>
        <div class="canvas-region canvas-region-voice">
          <p class="technical-label">Voice and tone</p>
          <p class="mt-auto font-medium text-sm">Assured. Clear. Human.</p>
        </div>
        <div class="canvas-region canvas-region-ui">
          <p class="technical-label">Interface</p>
          <div class="mt-auto flex items-center justify-between rounded-lg bg-[#24334b] p-2 text-[#f7f1df]">
            <span class="text-xs">Plan route</span><span aria-hidden="true">→</span>
          </div>
        </div>
      </div>
      <p class="canvas-caption">Every Brand Region stays visible, connected, and ready to refine.</p>
    </div>
</section>

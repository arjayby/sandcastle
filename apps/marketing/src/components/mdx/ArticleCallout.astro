---
interface Props {
  title?: string;
}

const { title = "Keep in mind" } = Astro.props;
---

<aside class="my-8 rounded-[var(--sc-corner-panel)] border border-[var(--sc-color-sand)] bg-[var(--sc-color-surface)] p-5 sm:p-6">
  <p class="technical-label">{title}</p>
  <div class="mt-3 leading-7 text-[var(--sc-color-muted)]">
    <slot />
  </div>
</aside>

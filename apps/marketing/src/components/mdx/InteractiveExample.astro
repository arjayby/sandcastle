---
interface Props {
  summary: string;
}

const { summary } = Astro.props;
---

<details class="my-8 rounded-[var(--sc-corner-panel)] border border-[var(--sc-color-ink)] bg-[var(--sc-color-surface)] p-5 sm:p-6">
  <summary class="cursor-pointer rounded-[var(--sc-corner-control)] font-semibold">{summary}</summary>
  <div class="mt-4 border-t border-[var(--sc-color-sand)] pt-4 leading-7 text-[var(--sc-color-muted)]">
    <slot />
  </div>
</details>
